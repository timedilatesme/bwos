[
  {
    "id": 1,
    "priority": 10,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        { "header": "user-agent", "operation": "set", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; Xbox; Xbox One) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/70.0.3538.102 Safari/537.36 Edge/18.19041" },
        { "header": "sec-ch-ua", "operation": "remove" },
        { "header": "sec-ch-ua-mobile", "operation": "remove" },
        { "header": "sec-ch-ua-platform", "operation": "remove" }
      ]
    },
    "condition": {
      "regexFilter": "^https://www\\.youtube\\.com/tv(?:[/?#]|$)",
      "resourceTypes": ["main_frame", "sub_frame"]
    }
  }
]
