{
  "manifest_version": 3,
  "name": "BWOS TV",
  "version": "2.10.0",
  "description": "Controller navigation and persistent streaming apps inside BWOS, including YouTube TV.",
  "permissions": ["declarativeNetRequest", "storage", "tabs", "webRequest"],
  "host_permissions": ["*://www.youtube.com/*", "https://*.googlevideo.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "bwos-home": {
      "suggested_key": { "default": "Ctrl+Shift+Home" },
      "description": "Back to the BWOS home screen (pressed by BWOS for the controller's Home button)"
    }
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "youtube-tv", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*", "https://www.primevideo.com/*", "https://primevideo.com/*"],
      "js": ["recommendations.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["home.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "css": ["youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*"],
      "js": ["popups.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*/*"],
      "js": ["qr.js", "remote.js", "voice.js", "media.js"],
      "css": ["remote.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
